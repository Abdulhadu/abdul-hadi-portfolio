# ── Dependencies ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────────────────────
/.next/
/out/
/build
dist/

# ── Environment / Secrets — NEVER commit these ────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
