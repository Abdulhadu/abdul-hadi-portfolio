# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API

# Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Private — NEVER expose to browser. Server-side only (API routes).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Resend (email) ────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# Email that appears as the sender (must be a verified domain in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Your personal inbox that receives contact form submissions
RESEND_TO_EMAIL=your@email.com
